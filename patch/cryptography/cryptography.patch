diff --git a/src/cryptography/hazmat/primitives/hashes.py b/src/cryptography/hazmat/primitives/hashes.py
index 50ed355..d02d3d1 100644
--- a/src/cryptography/hazmat/primitives/hashes.py
+++ b/src/cryptography/hazmat/primitives/hashes.py
@@ -355,3 +355,19 @@ class SM3(HashAlgorithm):
             return NotImplemented
 
         return True
+
+class Provided(HashAlgorithm):
+    name = "sha256"
+    digest_size = 32
+    block_size = 64
+
+    def __init__(self, name: str, digest_size: int, block_size: int):
+        self.name = name
+        self.digest_size = digest_size
+        self.block_size = block_size
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Provided) or self.name != other.name:
+            return NotImplemented
+
+        return True
